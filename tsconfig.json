{
  "compilerOptions": {
    "target": "ES2019", // ~node18
    "module": "commonjs",
    "lib": [
      "es2015",
      "es2016",
      "es2017",
      "es2018",
      "es2019",
      "dom"
    ],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "noImplicitAny": false
  },
  "include": [
    "src/"
  ],
  "exclude": [
    "**/*.spec.ts",
    "src/device/AirConditioner.ts",
    "src/deviceStatus/airConditioner.ts"
  ],
  "ts-node": {
    "transpileOnly": true
  }
}
