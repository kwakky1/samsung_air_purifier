{
  "displayName": "Samsung Air Purifier (Home Assistant)",
  "name": "homebridge-samsung-air-purifier",
  "version": "2.0.0",
  "description": "A Homebridge plugin for controlling Samsung air purifiers exposed as Home Assistant entities, entirely over the local network.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kwakky1/samsung_air_purifier"
  },
  "bugs": {
    "url": "https://github.com/kwakky1/samsung_air_purifier/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "homebridge": ">=1.3.5"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint 'src/**/*.ts' --fix",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "test": "mocha",
    "prepublishOnly": "npm run lint && npm run build && npm test"
  },
  "keywords": [
    "homebridge-plugin"
  ],
  "devDependencies": {
    "@types/chai": "^4.3.6",
    "@types/mocha": "^10.0.1",
    "@types/node": "^18.16.0",
    "@types/ws": "^8.5.5",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "chai": "^4.3.8",
    "eslint": "^8.0.1",
    "hap-nodejs": "^0.10.0",
    "homebridge": "^1.4.0",
    "mocha": "^10.2.0",
    "nodemon": "^2.0.13",
    "prettier": "2.5.1",
    "rimraf": "^3.0.2",
    "ts-node": "^10.3.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "ws": "^8.14.2"
  }
}
